<Window x:Class="BorneRestaurant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenue" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/images/imgfondborne.jpg" Stretch="UniformToFill" Opacity="0.7"/>
        </Grid.Background>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">



            <Button Content="BIENVENUE"
        Width="190"
        Height="60"
        FontSize="22"
        Background="DarkRed"
        Foreground="White"
        BorderBrush="Black"
        BorderThickness="2"
        Margin="10"
        Click="BtnEntrer_Click"/>


        </StackPanel>
    </Grid>
</Window>
