<Window x:Class="BorneRestaurant.views.ChoixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BorneRestaurant"
        mc:Ignorable="d"
        Title="ChoixOrder" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/images/imgfondborne.jpg" Stretch="UniformToFill" Opacity="0.7"/>
        </Grid.Background>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">
            <TextBlock Text="Bienvenue chez HK Burger" 
                       FontSize="40"
                       FontWeight="Bold" Foreground="DarkRed" TextAlignment="Center" HorizontalAlignment="Center" Background="White"/>
            <TextBlock Text="Choisir le mode de commande:"
                       FontSize="24"
                       FontWeight="Bold" Foreground="White" TextAlignment="Center" HorizontalAlignment="Center"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Width="200" Padding="10" Margin="50,20,50,0"
                        Background="DarkRed" Foreground="White" BorderBrush="Black" BorderThickness="2"  Click="BtnSurplace_Click">
                    <StackPanel>
                        <TextBlock Text="🍴" FontSize="100" />
                        <TextBlock Text="Sur place" FontSize="30" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Width="200" Padding="10" Margin="50,25,50,0"
                        Background="DarkRed" Foreground="White" BorderBrush="Black" BorderThickness="2" Click="BtnEmporter_Click">
                    <StackPanel>
                        <TextBlock Text="🥡" FontSize="100" />
                        <TextBlock Text="A emporter" FontSize="30" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1">

            <Border CornerRadius="16"
        Background="DarkRed"
        Margin="20,0,0,15"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom">

                <Button Content="Retour"
            Width="100"
            Height="40"
            FontSize="20"
            Background="Transparent"
            Foreground="White"
            BorderThickness="0"
            Click="BtnRetour_Click"/>
            </Border>


        </Grid>

    </Grid>
</Window>